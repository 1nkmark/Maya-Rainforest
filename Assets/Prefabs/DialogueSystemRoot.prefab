  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8dc4925665546854e9a3219f309b619f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  allowSkipInteractionInEditor: 1
  disableReleaseWarningInEditor: 1
  speakerText: {fileID: 8796322572225904532}
  dialogueText: {fileID: 8515821937438952083}
  dialoguePanel: {fileID: 881664806793900288}
  speakerAvatarImage: {fileID: 8553826046244253745}
  speakerAvatars:
  - speaker: "\u80D6\u80D6"
    avatar: {fileID: 21300000, guid: 0c831b5ba889a9041bd110b40deb89fe, type: 3}
  - speaker: "\u8BFA\u4E9A"
    avatar: {fileID: 21300000, guid: eaaa5e81ba3ebf540a5b36b77102eb34, type: 3}
  - speaker: "\u3010\u4EA4\u4E92\u63D0\u793A\u3011"
    avatar: {fileID: 21300000, guid: 0c831b5ba889a9041bd110b40deb89fe, type: 3}
  - speaker: "\u3010\u6E29\u99A8\u63D0\u793A\u3011"
    avatar: {fileID: 21300000, guid: eaaa5e81ba3ebf540a5b36b77102eb34, type: 3}
  hideAvatarIfNotFound: 1
  dialogueLines:
  - speaker: "\u80D6\u80D6"
    content: "\u563F\uFF01\u65B0\u9762\u5B54\uFF01\u4F60\u5C31\u662F\u68A6\u535A\u58EB\u6D3E\u6765\u7684\u589E\u63F4\u5427\uFF1F"
    clip: {fileID: 8300000, guid: 2c94555acbded8e468ab3f739d94cc19, type: 3}
    waitType: 0
    visualHintObject: {fileID: 0}
  - speaker: "\u80D6\u80D6"
    content: "\u6211\u662F\u80D6\u80D6\uFF0C\u5730\u7403\u68A6\u4E4B\u961F\u7684\u884C\u52A8\u62C5\u5F53\uFF01"
    clip: {fileID: 8300000, guid: fdd4fd9f187ee7b40b6b643a25777eba, type: 3}
    waitType: 0
    visualHintObject: {fileID: 0}
  - speaker: "\u8BFA\u4E9A"
    content: "\u4F60\u597D\uFF0C\u6211\u662F\u8BFA\u4E9A\u3002"
    clip: {fileID: 8300000, guid: b3ddcc49793bbbf4db5050f79d410ade, type: 3}
    waitType: 0
    visualHintObject: {fileID: 0}
  - speaker: "\u8BFA\u4E9A"
    content: "\u771F\u9AD8\u5174\u4F60\u80FD\u6765\u5E2E\u52A9\u6211\u4EEC\u6536\u96C6\u739B\u96C5\u6587\u660E\u788E\u7247\u3002"
    clip: {fileID: 8300000, guid: 919181f752a718c45a552da287c84043, type: 3}
    waitType: 0
    visualHintObject: {fileID: 0}
  - speaker: "\u8BFA\u4E9A"
    content: "\u6211\u4EEC\u5931\u8054\u4E86\uFF0C\u800C\u53EA\u6709\u6587\u5316\u5171\u9E23\u4EEA\u624D\u80FD\u5E2E\u6211\u4EEC\u627E\u5230\u739B\u96C5\u9057\u5740\u7684\u65B9\u5411\u3002"
    clip: {fileID: 8300000, guid: b22ccbe39c80f9249a73fd1d7b7250a6, type: 3}
    waitType: 0
    visualHintObject: {fileID: 0}
  - speaker: "\u80D6\u80D6"
    content: "\u63A2\u9669\u5BB6\uFF0C\u5FEB\u62FF\u8D77\u6587\u5316\u5171\u9E23\u4EEA\u5427\uFF01"
    clip: {fileID: 8300000, guid: 567557b99336d0e4ea42e37204a871df, type: 3}
    waitType: 0
    visualHintObject: {fileID: 0}
  - speaker: "\u3010\u4EA4\u4E92\u63D0\u793A\u3011"
    content: "\u7528\u5DE6\u624B\u67C4\u5BF9\u51C6\u811A\u8FB9\u7684 [\u6587\u5316\u5171\u9E23\u4EEA]
      \uFF0C\u6309\u4E0B [\u5DE6\u624B\u4E2D\u6307\u6293\u63E1\u952E] \u5E76 [\u957F\u6309]
      \u62FE\u8D77\u3002"
    clip: {fileID: 0}
    waitType: 1
    visualHintObject: {fileID: 7026873216495383541}
  - speaker: "\u3010\u4EA4\u4E92\u63D0\u793A\u3011"
    content: "\u6309\u4E0B [\u5DE6\u624B\u98DF\u6307\u6273\u673A\u952E] \u6253\u5F00\u6587\u5316\u5171\u9E23\u4EEA\u3002"
    clip: {fileID: 0}
    waitType: 2
    visualHintObject: {fileID: 7026873216495383541}
  autoPlayDelay: 0.5
  textModeDelay: 2
  useRightGrip: 0
  infraredGrabInteractable: {fileID: 0}
  infraredObject: {fileID: 0}
  openDetectMode: 2
  heatmapRenderer: {fileID: 0}
  heatmapObject: {fileID: 0}
  warningSpeaker: "\u6E29\u99A8\u63D0\u793A"
  releaseWarningText: "\u8BF7 [\u957F\u6309] \u5DE6\u624B\u4E2D\u6307\u6293\u63E1\u952E\uFF0C\u677E\u5F00\u6309\u952E\u6587\u5316\u5171\u9E23\u4EEA\u4F1A\u6389\u843D\u54DF\uFF01"
  releaseWarningDuration: 2.5
  showDebugLog: 1
