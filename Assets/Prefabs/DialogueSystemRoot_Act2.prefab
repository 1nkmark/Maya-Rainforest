  dialogueLines:
  - speaker: "\u80D6\u80D6"
    content: "\u77A7\uFF0C\u6587\u5316\u5171\u9E23\u4EEA\u628A\u6211\u4EEC\u5E26\u5230\u4E86\u739B\u96C5\u91D1\u5B57\u5854\u524D\u3002"
    clip: {fileID: 8300000, guid: 037ebb5e19575ff40ae2a7f3b059b92e, type: 3}
    lineId: "\u80D6\u80D61"
    beforeLineStageAction: 0
    waitType: 0
    showMayaImage: 0
    mayaImageObject: {fileID: 0}
    mayaImageFadeInDuration: 0.5
    mayaImageStayDuration: 3
    mayaImageFadeOutDuration: 0.5
    useTimeoutBranch: 0
    timeLimit: 8
    successTargetLineId: 
    timeoutTargetLineId: 
    successNextLineIndex: -1
    timeoutNextLineIndex: -1
    afterLineStageAction: 0
    afterLineTargetLineId: 
    visualHintObject: {fileID: 0}
  - speaker: "\u80D6\u80D6"
    content: "\u54E6\u770B\u54EA\uFF0C\u8FD9\u9762\u5927\u677F\u5B50\u83AB\u975E\u5C31\u662F\u4F20\u95FB\u4E2D\u7684\u739B\u96C5\u6570\u5B57\u77F3\u7891\uFF1F"
    clip: {fileID: 8300000, guid: 96de1ed89bf8225489adead17753cd22, type: 3}
    lineId: "\u80D6\u80D62"
    beforeLineStageAction: 0
    waitType: 0
    showMayaImage: 0
    mayaImageObject: {fileID: 0}
    mayaImageFadeInDuration: 0.5
    mayaImageStayDuration: 3
    mayaImageFadeOutDuration: 0.5
    useTimeoutBranch: 0
    timeLimit: 8
    successTargetLineId: 
    timeoutTargetLineId: 
    successNextLineIndex: -1
    timeoutNextLineIndex: -1
    afterLineStageAction: 0
    afterLineTargetLineId: 
    visualHintObject: {fileID: 0}
  - speaker: "\u8BFA\u4E9A"
    content: "\u662F\u7684\uFF0C\u53EA\u6709\u6B63\u786E\u753B\u51FA\u739B\u96C5\u6570\u5B57\uFF0C\u624D\u80FD\u6536\u83B7\u739B\u96C5\u6570\u5B57\u6587\u5316\u7684\u788E\u7247\u3002"
    clip: {fileID: 8300000, guid: cc345d03a2dc5f74dadf4361f734ea35, type: 3}
    lineId: "\u8BFA\u4E9A1"
    beforeLineStageAction: 0
    waitType: 0
    showMayaImage: 0
    mayaImageObject: {fileID: 0}
    mayaImageFadeInDuration: 0.5
    mayaImageStayDuration: 3
