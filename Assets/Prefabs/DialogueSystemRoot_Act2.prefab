    timeoutNextLineIndex: -1
    afterLineStageAction: 0
    afterLineTargetLineId: 
    visualHintObject: {fileID: 0}
  - speaker: "\u8BFA\u4E9A"
    content: "\u739B\u96C5\u6570\u5B57\u4E0D\u53EA\u662F\u62BD\u8C61\u6570\u5B66\uFF0C\u8FD8\u662F\u5BF9\u81EA\u7136\u8282\u5F8B\u7684\u8BB0\u5F55\uFF1A\u739B\u96C5\u4EBA\u7528\u6570\u5B57\u8BB0\u5F55\u96E8\u5B63\uFF0C\u8BB0\u5F55\u7389\u7C73\u7684\u751F\u957F\u5468\u671F\uFF0C\u8BB0\u5F55\u661F\u8FB0\u8F6E\u8F6C\u3002"
