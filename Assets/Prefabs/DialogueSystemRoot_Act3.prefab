  dialogueLines:
  - speaker: "\u8BFA\u4E9A"
    content: "\u6211\u4EEC\u5DF2\u7ECF\u8FDB\u5165\u91D1\u5B57\u5854\u5185\u90E8\u3002\u8FD9\u91D1\u5B57\u5854\u7684\u4E3B\u4EBA\uFF0C\u662F\u5E15\u4F26\u514B\u7684\u56FD\u738B\u57FA\u5C3C\u5947\xB7\u574E\xB7\u5DF4\u8D6B\u62C9\u59C6\u4E8C\u4E16\u3002"
